{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"}]}],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh"}]},
      {"matcher": "*", "hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shipm-state.sh working"}]}
    ],
    "PostToolUse": [
      {"matcher": "ExitPlanMode", "hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/save-plan.sh"}]}
    ],
    "Stop": [{"hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh"}]}]
  }
}
