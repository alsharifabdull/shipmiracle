{
  "_": "Paths and whether the export selects them (allowlist minus hard-never; overlay files are added separately). Synthetic names only; {bin} and {hooks} stand for the folder names (the closure rule must not read them as references).",
  "include": [
    "shipmiracle/__init__.py",
    "shipmiracle/hooks/flow.py",
    "bin/shipm",
    "bin/test-all",
    "bin/doctor",
    "hooks/shipm-hook",
    "agents/claude/devops-sre.md",
    "templates/base/.githooks/pre-push",
    "vscode-ext/shipmiracle-panel/extension.js",
    "docs/standards/base.md",
    "docs/idea-review-method.md",
    "skills/skills.lock.json",
    "config/ideas.json",
    "config/watch.json",
    "tests/shipmiracle_cli_test.py",
    "tests/panel_test.js",
    "tests/shipmiracle_timing.py",
    "tests/shipmiracle_isolation.py",
    "tests/shipmiracle_isolation.js",
    "tests/chrome_helper.js",
    "tests/chrome_helper_test.js",
    "tests/settings_isolation_test.py",
    "tests/watch_stray_test.py",
    "tests/fixtures/flow/pretooluse-main.json",
    "tests/fakes/bin/claude"
  ],
  "exclude": [
    "memory/GLOBAL.md",
    "docs/STATUS.md",
    "docs/DECISIONS.md",
    "docs/parity.md",
    "docs/plans/2026-10-20-p8-spec.md",
    "docs/standards/known/v1.md",
    "docs/owner-steps/p8-private-defaults.sh",
    "dotfiles/zshrc",
    "reports/x.md",
    ".claude/settings.json",
    "tests/private/parity_test.py",
    "tests/private/fixtures/health/2026-10-19/transcript.jsonl",
    "skills/hig-foundations/SKILL.md",
    "skills/swiftui-pro/SKILL.md",
    "config/flow.json",
    "config/ci-hold.txt",
    "release/allowlist.txt",
    "release/overlay/README.md",
    "{bin}/shipm-baseline",
    "{bin}/dotfiles",
    "{bin}/delete-project",
    "{bin}/sync-tools",
    "{hooks}/flow-gate.sh",
    "CLAUDE.md",
    "README.md",
    ".env",
    "tests/fixtures/x/.env",
    "tests/fixtures/panel-v3/idle-light.png",
    "docs/summary/panel-shots-manifest.json",
    "something/else.txt"
  ],
  "overlay_wins": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CLAUDE.md",
    ".gitignore",
    "config/flow.json",
    "config/ci-hold.txt",
    "skills/APPROVED.md",
    ".github/workflows/ci.yml",
    ".github/ISSUE_TEMPLATE/bug.yml",
    ".github/ISSUE_TEMPLATE/feature.yml",
    ".github/pull_request_template.md",
    "release/VERSION",
    "release/closure-exempt.txt",
    "release/fixtures-reviewed.txt",
    "release/placeholders.txt",
    "vscode-ext/shipmiracle-panel/package.json"
  ]
}
