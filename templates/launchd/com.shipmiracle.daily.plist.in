<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.shipmiracle.daily</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>@WS@/bin/daily</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>@STATE@/v1/logs/launchd-daily.log</string>
  <key>StandardErrorPath</key><string>@STATE@/v1/logs/launchd-daily.log</string>
</dict></plist>
