#!/usr/bin/env python3
"""skills-sync: install the approved skills at their PINNED commit (git clone + checkout + copy). It never updates anything by itself.

  skills-sync [--dry]                         install the missing GLOBAL skills of skills/APPROVED.md (unpinned ones are skipped)
  skills-sync --project NAME --pack PACK      install a pack (web, ...) into one project, pinned; [--dry] prints only
  skills-sync --pin --online                  resolve `unpinned` entries to a commit (clones; only a commit whose folder equals the installed one)
  skills-sync --pin --online --repin NAME[,NAME]  owner terminal only: refresh the lock's tree_sha256 of an already pinned skill from its pinned checkout
                                              (never moves the commit; shows commit/tree before -> after and files added/removed; asks y/N)
  skills-sync --pin --online --from-commit NAME[,NAME]  owner terminal only: for an APPROVED, commit-pinned skill that was never installed, fill
                                              path + tree_sha256 from the pinned commit (clones; the folder name must be unique in the repo; shows
                                              before -> after and the files; asks y/N; writes only skills/skills.lock.json; never 'all')
  skills-sync --diff [--online]             weekly diff: "N updates waiting"; --online reads upstream HEAD with `git ls-remote` (the only network call)
  skills-sync --update                        deprecated (bin/daily still passes it): shows the diff, updates nothing
Real runs are owner steps; the tests use --dry or a temp HOME. Logic: shipmiracle/skills.py."""
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from shipmiracle import skills  # noqa: E402

if __name__ == "__main__":
    sys.exit(skills.sync_main(sys.argv[1:]))
