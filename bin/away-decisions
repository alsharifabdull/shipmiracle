#!/usr/bin/env python3
"""away-decisions — choices Claude made by itself while the owner was away (the keep-going hook logs each one).

  away-decisions list [--cr CR-012]   unreviewed decisions, newest first (--cr: only those logged for that change request)
  away-decisions render   write ~/.local/state/shipmiracle/away-decisions.md (newest first) and print its path
  away-decisions review   mark everything so far as reviewed (stored in ~/.local/state/shipmiracle/away-reviewed)
Tests: SHIPMIRACLE_STATE=<dir> moves the state dir."""
import json, os, pathlib, sys, time

STATE = pathlib.Path(os.environ.get("SHIPMIRACLE_STATE", pathlib.Path.home() / ".local/state/shipmiracle"))
LOG, MD, SEEN = STATE / "away-decisions.jsonl", STATE / "away-decisions.md", STATE / "away-reviewed"


def entries():
    out = []
    try:
        lines = LOG.read_text(errors="ignore").splitlines()
    except Exception:
        return out
    for line in lines:
        try:
            e = json.loads(line)
            out.append({"ts": float(e["ts"]), "project": str(e.get("project", "")), "question": str(e.get("question", "")),
                        "cr": e.get("cr") if isinstance(e.get("cr"), str) else None, "rule": e.get("rule") if isinstance(e.get("rule"), str) else None})
        except Exception:
            continue
    return sorted(out, key=lambda e: -e["ts"])


def reviewed():
    try:
        return float(SEEN.read_text().strip())
    except Exception:
        return 0.0


def unreviewed(cr=None):
    r = reviewed()
    return [e for e in entries() if e["ts"] > r and (cr is None or e.get("cr") == cr)]


def stamp(ts):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts))


def main():
    args = sys.argv[1:]
    cr = None
    if "--cr" in args:
        i = args.index("--cr")
        cr = args[i + 1] if i + 1 < len(args) else ""
        args = args[:i] + args[i + 2:]
        if not cr:
            print("--cr needs a change request id like CR-012")
            sys.exit(2)
    cmd = (args or ["list"])[0]
    if cmd == "list":
        es = unreviewed(cr)
        for e in es:
            wait = "(waiting, nothing chosen) " if e.get("rule") == "away_wait" else ""
            print(f"{stamp(e['ts'])}  {e['project']}: {wait}{e['question']}")
        if not es:
            print("no unreviewed decisions")
    elif cmd == "render":
        es = unreviewed()
        body = ("# Decisions taken while away\n\nClaude chose its own recommended safe option at these moments (newest first). "
                "The question is the end of its last message.\n\n")
        body += "".join(f"## {e['project']} · {stamp(e['ts'])}\n\n{e['question']}\n\n" for e in es) if es else "Nothing new.\n"
        STATE.mkdir(parents=True, exist_ok=True)
        tmp = MD.with_suffix(".md.tmp")
        tmp.write_text(body)
        tmp.replace(MD)
        print(MD)
    elif cmd == "review":
        STATE.mkdir(parents=True, exist_ok=True)
        SEEN.write_text(str(time.time()))
        print("reviewed")
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
