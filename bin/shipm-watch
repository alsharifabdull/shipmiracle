    from shipmiracle.playbook import store as shipmiracle_cr
except BaseException as _e:
    if isinstance(_e, KeyboardInterrupt):
        raise
    shipmiracle_cr = None
try:
    from shipmiracle.autopilot import state as shipmiracle_ap
except BaseException as _e:
    if isinstance(_e, KeyboardInterrupt):
        raise
    shipmiracle_ap = None

def env(name, default=None):
    """SHIPMIRACLE_* overrides exist for tests only: they count when SHIPMIRACLE_TEST=1 (like bin/shipm-chat), so a stray variable can never redirect the watcher."""
    return os.environ.get(name, default) if os.environ.get("SHIPMIRACLE_TEST") == "1" else default


HOME = pathlib.Path(env("SHIPMIRACLE_HOME", pathlib.Path.home()))
WS = pathlib.Path(env("SHIPMIRACLE_WS", pathlib.Path(__file__).resolve().parent.parent))
STATE = pathlib.Path(env("SHIPMIRACLE_STATE", HOME / ".local/state/shipmiracle"))
DEV = pathlib.Path(env("SHIPMIRACLE_DEV", HOME / "Developer"))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
try:
    from shipmiracle import platform as aplat      # OS differences (macOS commands unchanged, Linux reads /proc); without it the macOS code below runs as before
except Exception:
    aplat = None
TMP = pathlib.Path(env("SHIPMIRACLE_TMP", aplat.claude_tmp_dir() if aplat else f"/private/tmp/claude-{os.getuid()}"))
GIT = "/usr/bin/git"; LSOF = "/usr/sbin/lsof"
DEFAULTS = {"frozen_min": 20, "agent_frozen_min": 20, "job_silent_min": 30, "job_age_h": 2, "idle_session_h": 24, "host_swap_pct": 80, "host_swap_clear": 70,
            "host_free_pct": 20, "host_free_clear": 30, "host_load_x": 2.0, "host_load_clear": 1.5, "host_scans": 5, "hog_gb": 4, "hog_cpu": 300, "hog_scans": 10,
            "vm_hours": 24, "orphan_min": 30, "orphan_cpu": 2, "stale_agent_h": 3, "stale_quiet_min": 20, "output_days": 7, "hold_release_min": 30, "session_large_mb": 80,
            "api_errors": 3, "compactions": 3, "stray_browser_min": 30, "stray_testrun_min": 20, "auto": True, "auto_dead_agents": True, "housekeeping_every_min": 60, "busy_cpu": 2.0}
SAFE = {   # what could be lost by each button, said plainly (the checkpoint skips secret files and files over 5 MB, it never changes them)
    "interrupt": "Nothing is lost; the chat stays open and you can carry on.",
    "relaunch": "Your files and the conversation are kept (files saved to a wip branch first, conversation stays on disk). Only a tool call running at this very moment is cut off.",
    "fresh": "Nothing is deleted (files saved to a wip branch, the old conversation stays on disk, /resume brings it back). The new chat starts from STATUS and memory, so details that were only in the long chat are not in its head.",
    "end-job": "Files are saved to a wip branch first. Only the job's own unfinished output is lost.",
    "end-proc": "It belongs to no chat. Only its unsaved in-memory state is lost.",
    "quit-session": "Files saved to a wip branch first; the conversation stays on disk and reopens from the Projects button.",
    "close-duplicate": "Files saved to a wip branch first; the VS Code copy of the same conversation keeps going.",
    "stop-colima": "No container is running, so no data is lost; images and volumes stay and start again with the VM.",
    "pause-agents": "Nothing is lost; press Resume any time.",
    "drop-record": "Only the watcher's bookkeeping changes; no process is touched.",
    "end-browser": "Only automation browsers whose profile folder is in a temp folder are ended; a browser with any other profile is never touched.",
    "end-testrun": "Only that test-all run gets SIGTERM (it cleans its own children). Nothing else is touched.",
}
INFRA = re.compile(r"playwright|mcp-server|@modelcontextprotocol|caffeinate|shell-snapshots|^ps |^lsof |ugrep|shipm-watch|shipm-guard")
ALLOW = re.compile(r"playwright-mcp|@playwright/mcp|mcp-server|^sleep \d{3,}|bash -c .*while true")
VM_RE = re.compile(r"Virtualization\.framework.*VirtualMachine|com\.apple\.Virtualization\.Virtu")
HOSTAGENT_RE = re.compile(r"limactl hostagent")
BIN_DIRS = ("/opt/homebrew/bin", "/usr/local/bin")   # launchd (the guard) has no Homebrew in PATH: tools are called by absolute path
INTERRUPT_RE = re.compile(r"Request interrupted by user")


def is_interrupt(line):
    """Only a user record whose message text STARTS with '[Request interrupted by user' counts. The string quoted in a tool result, an assistant text or a file
    that was read does not."""
    if not INTERRUPT_RE.search(line):
        return False
    try:
        r = json.loads(line)
        if not isinstance(r, dict) or r.get("type") != "user":
            return False
        c = (r.get("message") or {}).get("content")
        texts = [c] if isinstance(c, str) else [b.get("text", "") for b in (c or []) if isinstance(b, dict) and b.get("type") == "text"]
        return any(isinstance(t, str) and t.startswith("[Request interrupted by user") for t in texts)
    except Exception:
        return False


def now():
    return float(env("SHIPMIRACLE_NOW") or time.time())


def jread(p, d=None):
    try:
        return json.loads(pathlib.Path(p).read_text())
    except Exception:
        return d


def jwrite(p, obj, mode=None):
    p = pathlib.Path(p); p.parent.mkdir(parents=True, exist_ok=True)
    t = p.with_name("." + p.name + ".tmp")
    if mode is None:
        t.write_text(json.dumps(obj))
    else:
        fd = os.open(str(t), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w") as fh:
            fh.write(json.dumps(obj))
        os.chmod(str(t), mode)
    t.replace(p)


SECRET_RE = re.compile(r"(?i)(token|key|secret|password|authorization|bearer|passwd)([=: ]+)(?:(?:bearer|basic)\s+)?\S+")
B64_RE = re.compile(r"[A-Za-z0-9+/_-]{40,}={0,2}")


def red(text):
    """A command line as it may be stored or shown: secrets and long base64-looking runs removed."""
    return B64_RE.sub("<redacted>", SECRET_RE.sub(lambda m: m.group(1) + m.group(2) + "<redacted>", str(text)))


def cfg():
    c = dict(DEFAULTS); u = jread(WS / "config/watch.json", {})
    c.update(u if isinstance(u, dict) else {}); return c


def sh(cmd, timeout=10, env=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env); return r.returncode, (r.stdout + r.stderr)
    except Exception as e:
        return 1, repr(e)


def log(msg):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "events.log", "a") as f:
        f.write(f"{time.strftime('%F %T', time.localtime(now()))} watch: {msg}\n")


def tool(name):
    """Absolute path of a tool (docker, colima) or '' — never from PATH."""
    for d in BIN_DIRS:
        p = os.path.join(d, name)
        if os.access(p, os.X_OK):
            return p
    return ""


def tool_env():
    return dict(os.environ, PATH=os.environ.get("PATH", "") + ":" + ":".join(BIN_DIRS))


def hhmm(ts):
    return time.strftime("%H:%M", time.localtime(ts))


# ---------- readings ----------
def etime_s(s):
    d = 0
    if "-" in s:
        a, s = s.split("-", 1); d = int(a)
    p = [int(x) for x in s.split(":")]
    while len(p) < 3:
        p.insert(0, 0)
    return d * 86400 + p[0] * 3600 + p[1] * 60 + p[2]


def read_ps():
    f = env("SHIPMIRACLE_PS")
    out = pathlib.Path(f).read_text() if f else sh(["/bin/ps", "-axo", "pid=,ppid=,etime=,pcpu=,rss=,command="], 15)[1]
    procs, t = {}, now()
    for line in out.splitlines():
        m = re.match(r"^\s*(\d+)\s+(\d+)\s+(\S+)\s+([\d.]+)\s+(\d+)\s+(.*)$", line)
        if m:
            pid = int(m.group(1)); age = etime_s(m.group(3))
            procs[pid] = {"pid": pid, "ppid": int(m.group(2)), "age": age, "start": t - age, "cpu": float(m.group(4)), "rss": int(m.group(5)) / 1024.0, "cmd": m.group(6)}
    return procs


def cwd_of(pid):
    f = env("SHIPMIRACLE_LSOF")
    if f:
        return (jread(f, {}) or {}).get(str(pid), "")
    if aplat:
        return aplat.pid_cwd(pid)
    rc, out = sh([LSOF, "-a", "-p", str(pid), "-d", "cwd", "-Fn"], 4)
    m = re.search(r"\nn(.+)", out)
    return m.group(1) if m else ""


def host_readings():
    f = env("SHIPMIRACLE_HOST")
    if f:
        return jread(f, {})
    if aplat:
        r = aplat.host_load()      # a value nobody could read is listed in "unknown" (neutral numbers here, so the monitor raises no false alarm; `host` says unknown)
        h = {"swap_pct": 0, "free_pct": 100, "load": 0.0, "cores": 1, "vm_gb": 0, "unknown": list(r["unknown"])}
        for k in ("swap_pct", "free_pct", "load", "cores"):
            if r[k] is not None:
                h[k] = r[k]
        return h
    h = {"swap_pct": 0, "free_pct": 100, "load": 0.0, "cores": 1, "vm_gb": 0}
    rc, o = sh(["/usr/sbin/sysctl", "-n", "vm.swapusage"]); m = re.search(r"total = ([\d.]+)M\s+used = ([\d.]+)M", o)
    if m and float(m.group(1)) > 0:
        h["swap_pct"] = round(100 * float(m.group(2)) / float(m.group(1)), 1)
    rc, o = sh(["/usr/sbin/sysctl", "-n", "vm.loadavg"]); m = re.search(r"([\d.]+)", o); h["load"] = float(m.group(1)) if m else 0.0
    rc, o = sh(["/usr/sbin/sysctl", "-n", "hw.ncpu"]); h["cores"] = int(o.strip() or 1) if o.strip().isdigit() else 1
    rc, o = sh(["/usr/sbin/sysctl", "-n", "hw.memsize"]); mem = int(o.strip()) if o.strip().isdigit() else 0
    rc, o = sh(["/usr/bin/vm_stat"])
    pg = re.search(r"page size of (\d+)", o); free = sum(int(x) for x in re.findall(r"Pages (?:free|inactive|speculative):\s+(\d+)", o))
    if mem and pg:
        h["free_pct"] = round(100 * free * int(pg.group(1)) / mem, 1)
    return h


def docker_ask():
    """(ok, rows): rows = [(container name, compose working_dir)]. ok False = Docker cannot be asked (not installed, VM stopped, timeout)."""
    f = env("SHIPMIRACLE_DOCKER")
    if f:
        try:
            lines = pathlib.Path(f).read_text().splitlines()
        except OSError:
            return False, []
        if lines and lines[0].strip() == "ERROR":
            return False, []
        return True, [tuple((ln.split("\t") + [""])[:2]) for ln in lines if ln.strip()]
    d = tool("docker")
    if not d:
        return False, []
    rc, out = sh([d, "--context", "colima", "ps", "--format", '{{.Names}}\t{{.Label "com.docker.compose.project.working_dir"}}'], 4, tool_env())
    if rc != 0:
        return False, []
    return True, [tuple((ln.split("\t") + [""])[:2]) for ln in out.splitlines() if ln.strip()]


def colima_running():
    f = env("SHIPMIRACLE_COLIMA")
    if f:
        try:
            return "running" in pathlib.Path(f).read_text()
        except OSError:
            return False
    c = tool("colima")
    return bool(c) and sh([c, "status"], 8, tool_env())[0] == 0


def projects():
    if shipmiracle_projects:
        try:
            return shipmiracle_projects.names(dev=DEV)
        except Exception:
            pass
    try:
        return sorted(p.name for p in DEV.iterdir() if (p / ".git").exists())
    except Exception:
        return []


def proj_dirs(name):
    root = HOME / ".claude/projects"
    try:
        own = {re.sub(r"[^A-Za-z0-9]", "-", str(base / name)) for base in (DEV, DEV.resolve())}      # the project's own folder under the projects folder always counts, even when that folder sits under a path with a 'tmp' part (a test sandbox)
        return [d for d in root.iterdir() if d.is_dir() and (d.name in own or (d.name.endswith("-" + name.replace(".", "-")) and "-tmp-" not in d.name))]
    except Exception:
        return []


def transcripts(name):
    """Newest session of the project: path, size, newest write (lead + sub-agents), and the agents' files."""
    best = None
    for d in proj_dirs(name):
        for f in d.glob("*.jsonl"):
            m = f.stat().st_mtime
            if not best or m > best[0]:
                best = (m, f)
    if not best:
        return None
    m, f = best; agents = {}
    sub = f.with_suffix("") / "subagents"
    if sub.exists():
        for g in sub.glob("agent-*.jsonl"):
            agents[g.stem[len("agent-"):]] = g.stat().st_mtime
    newest = max([m] + list(agents.values()))
    return {"path": str(f), "sid": f.stem, "size_mb": round(f.stat().st_size / 1048576, 1), "lead": m, "newest": newest, "agents": agents}


_tail_cache = {}


API_RE = re.compile(r'"subtype":\s*"api_error"')


def tail_signals(path, mtime, t):
    """API errors (10 min), compactions (2 h), 'Prompt is too long' (30 min) and the newest 'Request interrupted by user' marker (any age) from the last
    300 KB of a transcript. Cached per file version."""
    key = (path, mtime)
    if key not in _tail_cache:
        ev = []
        try:
            with open(path, "rb") as fh:
                fh.seek(0, 2); size = fh.tell(); fh.seek(max(0, size - 300_000)); data = fh.read().decode("utf-8", "ignore")
            for line in data.splitlines()[1 if size > 300_000 else 0:]:
                kind = ("interrupt" if is_interrupt(line) else "api" if API_RE.search(line) else "long" if "Prompt is too long" in line
                        else "compact" if ("compact_boundary" in line or '"isCompactSummary":true' in line) else "")
                if not kind:
                    continue
                m = re.search(r'"timestamp":\s*"([^"]+)"', line)
                try:
                    ts = datetime.datetime.fromisoformat(m.group(1).replace("Z", "+00:00")).timestamp() if m else mtime
                except Exception:
                    ts = mtime
                ev.append((kind, ts))
        except Exception:
            pass
        _tail_cache.clear(); _tail_cache[key] = ev
    ev = _tail_cache[key]
    return {"api": sum(1 for k, ts in ev if k == "api" and t - ts <= 600), "long": sum(1 for k, ts in ev if k == "long" and t - ts <= 1800),
            "compact": sum(1 for k, ts in ev if k == "compact" and t - ts <= 7200), "interrupt": max([ts for k, ts in ev if k == "interrupt"] or [0])}


# ---------- model of the machine ----------
def descendants(procs, pid):
    kids, out = {}, []
    for p in procs.values():
        kids.setdefault(p["ppid"], []).append(p["pid"])
    stack = list(kids.get(pid, []))
    while stack:
        x = stack.pop(); out.append(procs[x]); stack.extend(kids.get(x, []))
    return out


def chat_of(p, projs):
    """A chat process: (kind 'vscode'|'desktop'|'headless', project, session id or '') or None."""
    c = p["cmd"]
    if "Helpers/disclaimer" in c or "sandbox-exec" in c.split(" ")[0]:
        return None
    first = c.split(" --")[0].strip()  # the executable; desktop paths contain spaces ("Application Support")
    if " " in first and "claude.app/" not in first:
        first = c.split(" ")[0]
    desk = "claude.app/Contents/MacOS/claude" in first or "claude-code/" in first and first.endswith("/claude")
    if not (first.endswith("/claude") or first == "claude" or desk):
        return None
    if re.search(r"\s-p\s|\s--print\b", c):
        return ("headless", "", "")
    sid = (re.search(r"--resume[= ](\S+)", c) or [None, ""])[1]
    nm = re.search(r"--name[= ](\S+)", c)
    proj = nm.group(1) if nm else ""
    if not proj:
        cwd = cwd_of(p["pid"])
        for n in projs:
            if cwd == str(DEV / n) or cwd.startswith(str(DEV / n) + "/"):
                proj = n
    if not proj and sid:
        for n in projs:
            if any((d / f"{sid}.jsonl").exists() for d in proj_dirs(n)):
                proj = n
    return ("desktop" if desk else "vscode", proj, sid)


def app_name(cmd, is_vm=False):
    """A readable name for the app a process belongs to (for the Mac-busy text)."""
    if is_vm:
        return "Docker VM"
    m = re.search(r"([^/]+)\.app(?:/|$)", cmd)
    nm = m.group(1) if m else re.sub(r"^.*/", "", cmd.split(" --")[0].strip())[:30]
    return {"Visual Studio Code": "VS Code"}.get(nm, nm)


# ---------- the registry: every Health item kind and every action, declared once ----------
def ap_chat_alive(item, ctx):
    return (True, "") if ctx.live_by_proj.get(item["project"]) else (False, f"no live {item['project'] or 'project'} chat process")


def ap_interrupt(item, ctx):
    ok, why = ap_chat_alive(item, ctx)
    if not ok:
        return ok, why
    return (True, "") if ctx.working_now.get(item["project"]) else (False, "the chat is not in the middle of a turn: nothing to interrupt")


def ap_fresh(item, ctx):
    ok, why = ap_chat_alive(item, ctx)
    if not ok:
        return ok, why
    if item["kind"] == "session_large" and ctx.working_now.get(item["project"]):
        return False, "runs when the chat finishes its turn"
    return True, ""


def ap_proc(item, ctx):
    p = ctx.procs.get(item["pid"]) if item["pid"] else None
    return (True, "") if p and abs(p["start"] - item["start"]) <= 5 else (False, "that process is gone or changed; nothing done")


def ap_stop_colima(item, ctx):
    if not colima_running():
        return False, "the Docker VM (Colima) is not running"
    ok, rows = ctx.docker_ps()
    if not ok:
        return False, "could not ask Docker whether containers run"
    return (False, f"{len(rows)} container(s) still run") if rows else (True, "")


def ap_pause(item, ctx):
    if (STATE / "agents.paused").exists():
        return False, "new agents are already paused"
    return (True, "") if ctx.live_agent_count() else (False, "none of our agents is running")


def ap_drop(item, ctx):
    return (True, "") if (item["project"], item.get("agent", "")) in ctx.dead else (False, "that agent record is not provably dead")


# ---------- stray automation browsers and orphaned test runs (21 Oct 2026) ----------
TEMP_ROOTS = ("/tmp", "/private/tmp", "/var/folders", "/private/var/folders")
BROWSER_RE = re.compile(r"Google Chrome|Chrome for Testing|chrome-headless-shell|chromium", re.I)
UDD_RE = re.compile(r"(?:^| )--?user-data-dir=(\S+)")
UDD_ANY = re.compile(r"(?:^| )--?user-data-dir\b")        # every spelling that names a profile, with or without a value


def under_temp_root(path):
    """True when `path` (symlinks and .. resolved) is inside /tmp, /private/tmp, /var/folders or /private/var/folders. Resolves only; touches nothing."""
    if not path:
        return False
    r = os.path.realpath(str(path))
    return any(r == t or r.startswith(t.rstrip("/") + "/") for t in {os.path.realpath(x) for x in TEMP_ROOTS} | set(TEMP_ROOTS))


def udd_of(cmd):
    """The profile folder Chrome really uses: the LAST --user-data-dir (Chrome takes the last one), not the first (L5)."""
    ms = UDD_RE.findall(cmd)
    return ms[-1].strip().strip("\"'") if ms else ""


def temp_profile(cmd):
    """True only for exactly ONE --user-data-dir that is inside a temp folder. Two or more occurrences are ambiguous (a decoy first, the real profile last): never temp, never killable."""
    return len(UDD_ANY.findall(cmd)) == 1 and len(UDD_RE.findall(cmd)) == 1 and under_temp_root(udd_of(cmd))


def is_automation_browser(p):
    """The main process of a Chrome / Chrome for Testing started for automation (remote debugging port or headless); renderer and helper processes (--type=) are its children."""
    c = p["cmd"]
    return bool(BROWSER_RE.search(c)) and "--type=" not in c and ("--remote-debugging-port" in c or "--headless" in c)


def _ours_test_all(path):
    """The script is bin/test-all of this workspace, or of one of its git worktrees (<DEV>/.worktrees/<workspace name>/<x>/bin/test-all). A project's own test-all never is (L5)."""
    try:
        r = os.path.realpath(path)
    except (OSError, ValueError):
        return False
    if r == os.path.realpath(str(WS / "bin" / "test-all")):
        return True
    wt = os.path.realpath(str(DEV / ".worktrees" / WS.name))
    return r.startswith(wt + "/") and r.endswith("/bin/test-all") and r.count("/") == wt.count("/") + 3


def is_testrun(p):
    t = p["cmd"].split()
    if not t:
        return False
    b = os.path.basename(t[0])
    if b == "test-all":
        return _ours_test_all(t[0])
    return b.lower().startswith("python") and any(os.path.basename(x) == "test-all" and _ours_test_all(x) for x in t[1:3])


def inside_dev(path):
    """cwd of a process is inside a known workspace or worktree (the projects folder, or this workspace)."""
    if not path:
        return False
    r = os.path.realpath(path)
    return any(r == q or r.startswith(q.rstrip("/") + "/") for q in {os.path.realpath(str(DEV)), os.path.realpath(str(WS))})


def ap_browser(item, ctx):
    ok, why = ap_proc(item, ctx)
    if not ok:
        return ok, why
    p = ctx.procs[item["pid"]]
    if not is_automation_browser(p):
        return False, "that process is not an automation browser any more; nothing done"
    if not temp_profile(p["cmd"]):
        return False, "its profile folder is not in a temp folder: shipm-watch never touches it"
    return True, ""


def ap_testrun(item, ctx):
    ok, why = ap_proc(item, ctx)
    if not ok:
        return ok, why
    p = ctx.procs[item["pid"]]
    if not is_testrun(p) or not ctx.orphaned(p):
        return False, "that is not an orphaned test-all run any more; nothing done"
    if not inside_dev(cwd_of(p["pid"])):
        return False, "its folder is not inside a known workspace or worktree: not touched"
    return True, ""


OPS = {
    "interrupt": dict(executor="ext", wait_s=8, checks=1, destructive=False, applicable=ap_interrupt),
    "relaunch": dict(executor="ext", wait_s=20, checks=3, destructive=True, applicable=ap_chat_alive),
    "fresh": dict(executor="ext", wait_s=20, checks=3, destructive=True, applicable=ap_fresh),
    "end-job": dict(executor="watch", wait_s=2, checks=1, destructive=True, applicable=ap_proc),
    "end-proc": dict(executor="watch", wait_s=2, checks=1, destructive=True, applicable=ap_proc),
    "quit-session": dict(executor="watch", wait_s=2, checks=1, destructive=True, applicable=ap_proc),
    "close-duplicate": dict(executor="watch", wait_s=2, checks=1, destructive=True, applicable=ap_proc),
    "stop-colima": dict(executor="watch", wait_s=5, checks=2, destructive=True, applicable=ap_stop_colima),
    "pause-agents": dict(executor="watch", wait_s=1, checks=1, destructive=False, applicable=ap_pause),
    "drop-record": dict(executor="watch", wait_s=0, checks=1, destructive=False, applicable=ap_drop),
    "end-browser": dict(executor="watch", wait_s=3, checks=2, destructive=True, applicable=ap_browser),
    "end-testrun": dict(executor="watch", wait_s=20, checks=2, destructive=True, applicable=ap_testrun),
}
